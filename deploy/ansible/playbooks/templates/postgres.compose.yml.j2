name: banking-db

services:
  postgres-account:
    image: postgres:16-alpine
    environment:
      POSTGRES_USER: banking
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:?POSTGRES_PASSWORD must be set}
      POSTGRES_DB: account
    # Bound to the overlay address only: reachable by other lab nodes through
    # WireGuard, invisible on the public interface.
    ports:
      - "{{ wg_ip }}:5432:5432"
    volumes:
      - pgdata_account:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U banking -d account"]
      interval: 5s
      timeout: 3s
      retries: 5
    restart: unless-stopped

  migrate:
    image: migrate/migrate
    profiles: [tools]
    volumes:
      - ./migrations:/migrations:ro
    entrypoint:
      - migrate
      - -path=/migrations
      - -database
      - postgres://banking:${POSTGRES_PASSWORD:?POSTGRES_PASSWORD must be set}@postgres-account:5432/account?sslmode=disable
    depends_on:
      postgres-account:
        condition: service_healthy

volumes:
  pgdata_account:
