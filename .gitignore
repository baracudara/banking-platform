# Go build artifacts
*.exe
*.exe~
*.dll
*.so
*.dylib
bin/

# Test / coverage output
*.test
*.out
coverage.*

# Environment and secrets
.env
.env.*
!.env.example

# Local workspace overrides - go.work itself IS committed (it defines the
# monorepo layout and must be identical on every machine), but go.work.sum
# is a local resolution artifact that churns between Go versions.
go.work.sum

# OS files
.DS_Store
Thumbs.db

# Editors
.idea/
.vscode/
*.swp

# Lab stand secrets (generated by Ansible, never committed)
deploy/ansible/.secrets/

# Local-only notes: AI assistant context and the lab journal contain
# addresses of personal machines and servers.
CLAUDE.md
CLAUDE.local.md
deploy/ansible/LAB_LOG.md
deploy/ansible/experiments
deploy/ansible/inventory.local.yml

# Personal roadmap notes (Russian, local only)
docs/plan-*.md
